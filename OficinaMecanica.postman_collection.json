    {
      "name": "3. Cadastrar Cliente",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function gerarCpf() {",
              "  const num = () => Math.floor(Math.random() * 9);",
              "  const n1 = num(), n2 = num(), n3 = num(), n4 = num(), n5 = num(), n6 = num(), n7 = num(), n8 = num(), n9 = num();",
              "  ",
              "  let d1 = n9*2 + n8*3 + n7*4 + n6*5 + n5*6 + n4*7 + n3*8 + n2*9 + n1*10;",
              "  d1 = 11 - (d1 % 11);",
              "  if (d1 >= 10) d1 = 0;",
              "  ",
              "  let d2 = d1*2 + n9*3 + n8*4 + n7*5 + n6*6 + n5*7 + n4*8 + n3*9 + n2*10 + n1*11;",
              "  d2 = 11 - (d2 % 11);",
              "  if (d2 >= 10) d2 = 0;",
              "  ",
              "  return `${n1}${n2}${n3}${n4}${n5}${n6}${n7}${n8}${n9}${d1}${d2}`;",
              "}",
              "pm.globals.set(\"cliente_cpf\", gerarCpf());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.globals.set(\"cliente_id\", jsonData.id);",
              "pm.test(\"Cliente criado com sucesso\", function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(jsonData.id).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
